# Copy to .env.neon for Neon, without overwriting the local fallback .env.
# Required pooled runtime URL and direct migration URL for the SAME Neon database.
# Replace placeholders locally. Never commit credentials.
DATABASE_URL="postgresql://USER:PASSWORD@PROJECT-pooler.REGION.aws.neon.tech/aurelia?sslmode=verify-full"
DIRECT_URL="postgresql://USER:PASSWORD@PROJECT.REGION.aws.neon.tech/aurelia?sslmode=verify-full"
SITE_URL="http://localhost:3000"
# Integration tests write fictional QA records and require explicit opt-in.
ALLOW_DB_TESTS="false"

# Phase 7: put these names in ignored .env.local (or .env.ai).
# Leave the key empty until configured locally. Never use NEXT_PUBLIC_ for AI secrets.
GEMINI_API_KEY=""
AURELIA_GEMINI_MODEL="gemini-3.1-flash-lite"
# OpenAI adapter retained but inactive; no automatic provider fallback.

# Phase 8: configure locally in ignored .env.local. Never use NEXT_PUBLIC_.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_VERIFY_TOKEN=""
META_APP_SECRET=""
# Optional supported Graph API version and public wa.me destination.
WHATSAPP_GRAPH_VERSION="v25.0"
WHATSAPP_PUBLIC_PHONE=""
