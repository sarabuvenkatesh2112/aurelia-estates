{
  "name": "aurelia-estates",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "oxlint",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "dev:local": "node scripts/run-local.mjs dev",
    "db:check": "node scripts/database-task.mjs check",
    "db:migrate": "node scripts/database-task.mjs migrate",
    "db:seed": "node scripts/database-task.mjs seed",
    "db:generate": "node scripts/database-task.mjs generate",
    "db:studio": "prisma studio",
    "db:local": "node scripts/local-postgres.mjs",
    "test:db": "node --conditions=react-server --import tsx --test tests/database.integration.ts",
    "test:auth": "node --conditions=react-server --import tsx --test tests/customer.integration.ts",
    "test:admin": "node --conditions=react-server --import tsx --test tests/admin.integration.ts",
    "test:admin:final": "node --conditions=react-server --import tsx --test tests/admin.final.integration.ts",
    "staff:bootstrap": "node --conditions=react-server --import tsx scripts/staff-bootstrap.ts",
    "predev": "node scripts/sync-map-assets.mjs",
    "prebuild": "node scripts/sync-map-assets.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@google/genai": "^2.23.0",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "better-auth": "^1.7.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "^17.4.2",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "lucide-react": "1.42.0",
    "maplibre-gl": "^6.11.2",
    "motion": "13.2.0",
    "next": "16.3.4",
    "openai": "^7.19.0",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "3.6.0",
    "three": "0.182.0",
    "tw-animate-css": "1.4.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.19",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "embedded-postgres": "^18.4.0-beta.17",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "prisma": "^7.10.0",
    "sharp": "^0.35.4",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.13",
    "typescript": "7.0.2"
  },
  "type": "module",
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.4"
  }
}
